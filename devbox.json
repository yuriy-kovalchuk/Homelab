{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.14.0/.schema/devbox.schema.json",
  "packages": [
    "gettext@latest",
    "kubectl@latest",
    "kubernetes-helm@latest",
    "kubeseal@latest",
    "terraform@latest",
    "talosctl@latest",
    "git@latest",
    "cilium-cli@latest",
    "hubble@latest",
    "fluxcd@latest"
  ],
  "shell": {
    "init_hook": [
      "chmod +x $DEVBOX_PROJECT_ROOT/devbox_scripts/*",
      "export $(cat $DEVBOX_PROJECT_ROOT/.env | xargs)",
      "source $DEVBOX_PROJECT_ROOT/devbox_scripts/tf_functions.sh"
    ],
"scripts": {
      "test": [
        "echo \"Error: no test specified\" && exit 1"
      ]
    }
  }
}

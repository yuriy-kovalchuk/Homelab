    {
      "type": "stat",
      "title": "Measured energy, last 24 h",
      "description": "CPU + RAM from the RAPL counters, plus the GTX 1070's average draw over the window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase(kepler_node_package_joules_total{instance=~\"$node\"}[24h])) + sum(increase(kepler_node_dram_joules_total{instance=~\"$node\"}[24h]))) / 3.6e6 + (sum(avg_over_time(nvidia_smi_power_draw_watts{node=~\"$node\"}[24h])) * 24 / 1000 or vector(0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null

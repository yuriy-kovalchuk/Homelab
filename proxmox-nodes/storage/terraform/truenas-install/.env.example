# Proxmox connection — prefixed with storage_ to avoid collision with gateway vars
TF_VAR_storage_proxmox_endpoint="https://10.0.3.2:8006/"
TF_VAR_storage_proxmox_username="root@pam"
TF_VAR_storage_proxmox_password=""

# PCIe passthrough — find with: lspci -nn | grep -i sata
TF_VAR_storage_pcie_controller="0000:04:00.0"

# VM
TF_VAR_storage_acme_domain="storage.example.com"

# ACME / Let's Encrypt (Cloudflare DNS challenge)
# These are shared across modules — set once in the global .env
# TF_VAR_acme_email=""
# TF_VAR_acme_cf_account_id=""
# TF_VAR_acme_cf_token=""


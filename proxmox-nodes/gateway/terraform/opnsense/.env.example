# Proxmox API
export TF_VAR_proxmox_endpoint="https://your-gateway-ip:8006/"
export TF_VAR_proxmox_username="root@pam"
export TF_VAR_proxmox_password=""

# VM Configuration
export TF_VAR_vm_id=1002
export TF_VAR_vm_name="opnsense"
export TF_VAR_vm_memory=4096
export TF_VAR_vm_cores=2
export TF_VAR_vm_disk_size=32

# Network
export TF_VAR_wan_bridge="vmbr0"
export TF_VAR_lan_bridge="vmbr1"
export TF_VAR_lan_bridge_port="enp3s0"  # physical NIC to attach to vmbr1 (check with: ip link show)

# OPNsense ISO — upload manually to Proxmox (local → ISO Images), then set the storage path here
# Download: curl -L <mirror-url>.iso.bz2 | bunzip2 > OPNsense-26.1.2-dvd-amd64.iso
export TF_VAR_opnsense_iso_file_id="local:iso/OPNsense-26.1.6-dvd-amd64.iso"

# Gateway — Proxmox API
export GATEWAY_PROXMOX_ENDPOINT="https://192.168.0.254:8006/"
export GATEWAY_PROXMOX_USERNAME="root@pam"
export GATEWAY_PROXMOX_PASSWORD=""

# Storage — Proxmox API
export STORAGE_PROXMOX_ENDPOINT="https://10.0.3.2:8006/"
export STORAGE_PROXMOX_USERNAME="root@pam"
export STORAGE_PROXMOX_PASSWORD=""

# Storage — PCIe passthrough (find with: lspci -nn | grep -i sata)
export STORAGE_PCIE_CONTROLLER="0000:04:00.0"

# Storage — ACME domain
export STORAGE_ACME_DOMAIN="storage.yuriy-lab.cloud"

# ACME / Let's Encrypt (Cloudflare DNS challenge)
export ACME_EMAIL=""
export ACME_CF_ACCOUNT_ID=""
export ACME_CF_TOKEN=""

# TrueNAS
export TRUENAS_HOST=""
export TRUENAS_TOKEN=""
export TRUENAS_POOL_NAME="tank"
export TRUENAS_POOL_DISKS='["nvme0n1"]'
export TRUENAS_NAS_USERNAME=""
